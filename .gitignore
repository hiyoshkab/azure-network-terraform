# Local .terraform directories (downloaded providers/modules)
**/.terraform/*

# State files — can contain secrets in plaintext, NEVER commit
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# tfvars often hold secrets/subscription-specific values
*.tfvars
*.tfvars.json

# Saved plan output can contain sensitive values
*.tfplan
*.tfplan.*

# Override files (usually local-only overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config and transient lock
.terraformrc
terraform.rc
.terraform.tfstate.lock.info

# Keep the provider dependency lock file committed:
!.terraform.lock.hcl
